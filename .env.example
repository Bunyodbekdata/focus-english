# Focus English — Environment Configuration
# Copy this file to .env.local for local testing, or configure these variables in Vercel Project Settings.
# NEVER prefix secret API keys with NEXT_PUBLIC_.

# ==============================================================================
# 1. DATABASE — Turso Cloud (libSQL)
# Leave blank locally to automatically use ./data/focus-english.db
# Required on Vercel:
# ==============================================================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ==============================================================================
# 2. FILE STORAGE — Vercel Blob (PDFs & Speaking Audio)
# Automatically injected when you connect a Blob store in Vercel Storage.
# Leave blank locally to automatically save under ./data/uploads/
# ==============================================================================
BLOB_READ_WRITE_TOKEN=
# Optional: "public" (default) or "private" to match your Vercel Blob store mode
# BLOB_ACCESS=public

# ==============================================================================
# 3. AI EXAMINER — Speaking (audio-based) & Writing Assessment
# Supported values: "gemini" (default, native multimodal audio) or "openai"
# ==============================================================================
AI_PROVIDER=gemini

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (alternative when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_SPEAKING_MODEL=gpt-4o-audio-preview
OPENAI_WRITING_MODEL=gpt-4o-mini
